{
  "name": "CV Dev",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "pip install -r requirements.txt --root-user-action=ignore",
  "remoteEnv": {
    "PYTHON": "python3",
    "PYTEST": "pytest",
    "RUFF": "ruff"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Preview site",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  }
}

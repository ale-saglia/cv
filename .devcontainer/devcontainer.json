{
  "name": "CV Dev",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "uv venv --clear .venv && uv pip sync requirements-dev.txt",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Preview site",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}

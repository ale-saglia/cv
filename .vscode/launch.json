{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Generate Index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_index.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: Injector (Dry-run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/injector.py",
      "args": ["--dry-run", "render", "src/en/master.yaml"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: Build Site",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_pages_site.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

{#- ─────────────────────────────────────────────────────────────────────────
    MACRO: render_entry
    Renders one experience / education / volunteering entry block.
    title_field, subtitle_field, org_field  — dict keys to pull from entry
    include_location — whether to append location to org string
    lang, month_abbrs — passed through for date formatting
────────────────────────────────────────────────────────────────────────── -#}
{%- macro render_entry(entry, title_field, subtitle_field, org_field, include_location, lang, month_abbrs) %}
        <div class="cv-entry">
{%- set title = entry[title_field] if entry[title_field] is defined and entry[title_field] else '' %}
{%- set subtitle = entry[subtitle_field] if subtitle_field and entry[subtitle_field] is defined and entry[subtitle_field] else '' %}
{%- if title %}
          <h3><strong>{{ title | e }}{% if subtitle %} in {{ subtitle | e }}{% endif %}</strong></h3>
{%- endif %}
{%- set org = entry[org_field] if entry[org_field] is defined and entry[org_field] else '' %}
{%- set location = entry.get('location', '') %}
{%- set start_raw = entry.get('start_date') %}
{%- set end_raw = entry.get('end_date') %}
{%- set date_raw = entry.get('date') %}
{%- if date_raw and not start_raw and not end_raw %}
{%- set date_str = date_raw %}
{%- elif start_raw or end_raw %}
{%- set date_str = format_date_range(start_raw, end_raw, lang, month_abbrs) %}
{%- else %}
{%- set date_str = '' %}
{%- endif %}
{%- if org or date_str %}
          <div class="cv-meta">
            <div><strong>{{ org | e }}{% if include_location and location %}, {{ location | e }}{% endif %}</strong></div>
{%- if date_str %}
            <div class="cv-date"><em>{{ date_str }}</em></div>
{%- endif %}
          </div>
{%- endif %}
{%- if entry.get('summary') %}
          <p>{{ entry.summary | mdi }}</p>
{%- endif %}
{%- set highlights = entry.get('highlights') %}
{%- if highlights %}
          <ul>
{%- for h in highlights %}
{%- if h %}
            <li>{{ h | mdi }}</li>
{%- endif %}
{%- endfor %}
          </ul>
{%- endif %}
        </div>

{%- endmacro -%}

{#- ─────────────────────────────────────────────────────────────────────────
    MACRO: render_cv_panel
    Renders the full CV section for one language.
────────────────────────────────────────────────────────────────────────── -#}
{%- macro render_cv_panel(lang, cv, locale, links) %}
{%- set month_abbrs = locale.month_abbreviations if locale.month_abbreviations else [] %}
{%- set sections = cv.sections %}
{%- set section_labels = locale.sections if locale.sections else {} %}
      <!-- {{ lang | upper }} CV -->
      <section id="cv-{{ lang }}" class="cv-content{% if lang == 'it' %} active{% endif %}"{% if lang != 'it' %} aria-hidden="true"{% endif %}>
        <div class="cv-header-links">
          <span class="cv-location">📍 {{ cv.location | e }}</span>
          <div class="cv-links-group hidden" id="cv-links-group-{{ lang }}">
{%- for link in links %}
            <a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.emoji }} {{ link['label_' + lang] }}</a>
{%- endfor %}
          </div>
          <div class="cv-links-dropdown" id="cv-links-dropdown-{{ lang }}" aria-label="Links menu">
            <button class="cv-links-dropdown-trigger" aria-expanded="false" aria-haspopup="true">{{ 'Link' if lang == 'it' else 'Links' }} <span class="cv-links-dropdown-arrow">▼</span></button>
            <div class="cv-links-dropdown-menu">
{%- for link in links %}
              <a href="{{ link.url }}" target="_blank" rel="noopener" class="cv-links-dropdown-item">{{ link.emoji }} {{ link['label_' + lang] }}</a>
{%- endfor %}
            </div>
          </div>
        </div>

{%- if 'summary' in sections %}
        <p class="cv-summary-title"><strong>{{ section_labels.summary }}</strong></p>
{%- for item in sections.summary %}
{%- if item is string %}
        <p>{{ item | mdi }}</p>
{%- endif %}
{%- endfor %}

{%- endif %}
{%- set toc_keys = ['experience', 'education', 'certification', 'volunteering_and_personal_projects', 'selected_awards', 'skills'] %}
{%- set ns = namespace(toc_items=[]) %}
{%- for key in toc_keys %}
{%- if key in sections and section_labels[key] is defined %}
{%- set ns.toc_items = ns.toc_items + [(section_labels[key], section_labels[key] | slug)] %}
{%- endif %}
{%- endfor %}
{%- if ns.toc_items %}
        <nav class="cv-toc">
{%- for title, anchor in ns.toc_items %}
          <a href="#{{ anchor }}">{{ title }}</a>
{%- endfor %}
        </nav>

{%- endif %}
{%- if 'experience' in sections %}
{%- set title = section_labels.experience %}
        <h2 id="{{ title | slug }}">{{ title }}</h2>

{%- for entry in sections.experience %}
{{ render_entry(entry, 'position', none, 'company', true, lang, month_abbrs) }}
{%- endfor %}
{%- endif %}
{%- if 'education' in sections %}
{%- set title = section_labels.education %}
        <h2 id="{{ title | slug }}">{{ title }}</h2>

{%- for entry in sections.education %}
{{ render_entry(entry, 'degree', 'area', 'institution', false, lang, month_abbrs) }}
{%- endfor %}
{%- endif %}
{%- if 'certification' in sections %}
{%- set title = section_labels.certification %}
        <h2 id="{{ title | slug }}">{{ title }}</h2>

{%- for cert in sections.certification %}
{%- if cert.label %}
        <div class="cv-entry cv-entry-minimal">
        <p><strong>{{ cert.label | e }}:</strong> {{ cert.details | e }}</p>
        </div>
{%- endif %}
{%- endfor %}

{%- endif %}
{%- if 'volunteering_and_personal_projects' in sections %}
{%- set title = section_labels.volunteering_and_personal_projects %}
        <h2 id="{{ title | slug }}">{{ title }}</h2>

{%- for entry in sections.volunteering_and_personal_projects %}
{{ render_entry(entry, 'position', none, 'company', true, lang, month_abbrs) }}
{%- endfor %}
{%- endif %}
{%- if 'selected_awards' in sections %}
{%- set title = section_labels.selected_awards %}
        <h2 id="{{ title | slug }}">{{ title }}</h2>

{%- for award in sections.selected_awards %}
{%- if award.bullet %}
        <div class="cv-entry cv-entry-minimal">
          <p>{{ award.bullet | mdi }}</p>
        </div>
{%- endif %}
{%- endfor %}

{%- endif %}
{%- if 'skills' in sections %}
{%- set title = section_labels.skills %}
        <h2 id="{{ title | slug }}">{{ title }}</h2>

{%- for skill in sections.skills %}
{%- if skill.label %}
        <div class="cv-entry cv-entry-minimal">
        <p><strong>{{ skill.label | e }}:</strong> {{ skill.details | e }}</p>
        </div>
{%- endif %}
{%- endfor %}
{%- endif %}
      </section>
{%- endmacro -%}

